{
  "name": "native-drawing-app",
  "version": "1.0.0",
  "description": "Cross-platform native drawing application with C++ rendering engine and Vue.js UI",
  "main": "dist-electron/main.js",
  "author": "Drawing Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:ui": "vite",
    "dev:electron": "electron .",
    "build": "npm run build:native && npm run build:ui && npm run build:electron",
    "build:native": "node-gyp rebuild",
    "build:ui": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "test": "npm run test:cpp && npm run test:unit && npm run test:e2e",
    "test:cpp": "cd build && ctest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ui/src --ext .ts,.vue",
    "format": "prettier --write \"ui/src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "vue": "^3.4.0",
    "pinia": "^2.1.0",
    "element-plus": "^2.5.0",
    "@element-plus/icons-vue": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "node-gyp": "^10.0.0",
    "node-addon-api": "^7.1.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "prettier": "^3.1.0",
    "@playwright/test": "^1.40.0"
  },
  "build": {
    "appId": "com.drawing.native-app",
    "productName": "NativeDrawingApp",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/Release/**/*.node",
      "!node_modules"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.graphics-design",
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Graphics",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
